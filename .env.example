# ==========================================
# WhatsApp
# ==========================================

WHATSAPP_GROUP_NAME=Red Boys💪
WHATSAPP_AUTH_DIR=./auth

CONTACT_PERSON=Akash
REMINDER_MINUTES_BEFORE_CLOSE=1
REMINDER_ENABLED=true


# ==========================================
# Lunch Menu
# ==========================================

MENU_ITEMS=Mini Thali,Chhole Bhature,Curd Rice,Aloo Paratha,Amritsari Thali,Aloo Paratha Meal,Dal Khichadi,Veg Hyderbadi Briyani,Poori Sbji,Methi Paratha Thali,kadhi Chawal,Custom Meal (contact Akash)


# ==========================================
# Poll
# ==========================================

POLL_TITLE=🍱 Today's Lunch
POLL_SELECTABLE_COUNT=1


# ==========================================
# Schedule
# ==========================================

TIMEZONE=Asia/Kolkata

# Test window. Production: POLL_TIME=11:00 CLOSE_TIME=12:30 REMINDER_MINUTES_BEFORE_CLOSE=10
POLL_TIME=18:47
CLOSE_TIME=18:50

# 7 = Sunday, included only so today's test can run. Production: 1,2,3,4,5
ACTIVE_DAYS=1,2,3,4,5,7


# ==========================================
# Bot
# ==========================================

AUTO_POLL_ENABLED=true
AUTO_CLOSE_ENABLED=true


# ==========================================
# Logging
# ==========================================

LOG_LEVEL=info

DATABASE_PATH=./data/lunch.db